{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,docs/beispieldaten,node_modules/three/build,node_modules/three/examples/jsm/controls,node_modules/bwip-js/dist,node_modules/xlsx/dist,node_modules/html5-qrcode}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
